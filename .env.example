# Environment configuration
PORT=3000
NODE_ENV=development

# Database configuration (PostgreSQL)
DATABASE_URL=postgresql://guardian:guardian_secret@localhost:5433/guardian_db?schema=public

# Security / JWT configuration
JWT_ACCESS_SECRET=replace_with_strong_jwt_access_secret_guardian
JWT_REFRESH_SECRET=replace_with_strong_jwt_refresh_secret_guardian
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Device heartbeat timeout (seconds)
HEARTBEAT_TIMEOUT_SECONDS=300

# Firebase Cloud Messaging service account credentials path
FIREBASE_SERVICE_ACCOUNT_PATH=

# Command pipeline TTL (seconds)
COMMAND_TTL_SECONDS=120
