datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  displayName   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  devices       Device[]
  issuedCommands Command[]     @relation("IssuedCommands")

  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())
  userAgent    String?

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

enum DeviceMode {
  PROTECTED
  CONTROLLER
}

model Device {
  id              String      @id @default(uuid())
  ownerId         String
  installId       String
  name            String
  platform        String
  model           String?
  osVersion       String?
  appVersion      String?
  mode            DeviceMode
  fcmToken        String?
  deviceTokenHash String?
  adminEnabled    Boolean     @default(false)
  batteryLevel    Int?
  isCharging      Boolean?
  lastSeenAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  owner           User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  commands        Command[]
  auditEvents     AuditEvent[]

  @@unique([ownerId, installId])
  @@index([ownerId])
  @@index([deviceTokenHash])
  @@map("devices")
}

enum CommandType {
  RING
  VIBRATE
  MESSAGE
  LOCK
}

enum CommandStatus {
  PENDING
  SENT
  DELIVERED
  EXECUTED
  FAILED
  EXPIRED
}

model Command {
  id            String        @id @default(uuid())
  deviceId      String
  issuedById    String
  type          CommandType
  payload       Json?
  status        CommandStatus @default(PENDING)
  failureReason String?
  createdAt     DateTime      @default(now())
  sentAt        DateTime?
  deliveredAt   DateTime?
  executedAt    DateTime?
  expiresAt     DateTime

  device        Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  issuedBy      User          @relation("IssuedCommands", fields: [issuedById], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([issuedById])
  @@index([status, expiresAt])
  @@map("commands")
}

model AuditEvent {
  id        String   @id @default(uuid())
  userId    String
  deviceId  String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deviceId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_events")
}
